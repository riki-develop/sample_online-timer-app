    "vite": "^7.2.4",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-sass-glob-import": "^5.0.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "browserslist": [
    "last 2 version",
